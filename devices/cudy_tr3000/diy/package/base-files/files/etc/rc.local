#!/bin/sh
# One-time Wi-Fi / package defaults, after OpenWrt has generated wireless config.
WIFI_PASSWD=__WIFI_PASSWD_SHELL__

for radio in $(uci -q show wireless | sed -n 's/^wireless\.\([^=]*\)=wifi-device$/\1/p'); do
	uci set "wireless.$radio.country=CN"
	uci set "wireless.$radio.disabled=0"
	case "$(uci -q get "wireless.$radio.band")" in
		2g) uci set "wireless.$radio.channel=auto" ;;
		5g) uci set "wireless.$radio.channel=149" ;;
	esac
done
for iface in $(uci -q show wireless | sed -n 's/^wireless\.\([^=]*\)=wifi-iface$/\1/p'); do
	[ "$(uci -q get "wireless.$iface.mode")" = 'ap' ] || continue
	radio=$(uci -q get "wireless.$iface.device")
	case "$(uci -q get "wireless.$radio.band")" in
		2g) uci set "wireless.$iface.ssid=Home 2.4G" ;;
		5g) uci set "wireless.$iface.ssid=Home 5G" ;;
		*) continue ;;
	esac
	uci set "wireless.$iface.disabled=0"
	uci set "wireless.$iface.encryption=psk2"
	uci set "wireless.$iface.key=$WIFI_PASSWD"
done
unset WIFI_PASSWD
uci commit wireless
wifi reload

if grep -q 'deny all;' /etc/nginx/restrict_locally 2>/dev/null && ! grep -q '100.64.0.0/10' /etc/nginx/restrict_locally 2>/dev/null; then
	T="$(printf '\t')"
	sed -i "/deny all;/i\\${T}allow 100.64.0.0/10;" /etc/nginx/restrict_locally
	/etc/init.d/nginx restart 2>/dev/null
fi
uci set turboacc.config.fastpath='disabled'
uci set turboacc.config.fastpath_fo_hw='0'
uci set turboacc.config.fullcone='1'
uci set turboacc.config.tcpcca='bbr'
uci commit turboacc
/etc/init.d/turboacc restart >/dev/null 2>&1

# Cover USB devices that enumerated before the first-boot WAN config existed.
/usr/sbin/f50-wan
rm -f "$0"
exit 0
