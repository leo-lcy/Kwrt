#!/bin/sh
#=================================================
# 开机末尾执行 (此时 wireless/nginx 配置均已生成)
# 幂等 + 自删: 只跑一次
#=================================================

# === WiFi: 配置双频 (disabled 由 diy.sh 改 mac80211.uc 默认值解决) ===
uci set wireless.@wifi-device[0].channel='6'
uci set wireless.@wifi-iface[0].ssid='Home 2.4G'
uci set wireless.@wifi-iface[0].key='__WIFI_PASSWD__'
uci set wireless.@wifi-iface[0].encryption='psk2'
uci set wireless.@wifi-device[1].channel='149'
uci set wireless.@wifi-iface[1].ssid='Home 5G'
uci set wireless.@wifi-iface[1].key='__WIFI_PASSWD__'
uci set wireless.@wifi-iface[1].encryption='psk2'
uci commit wireless
wifi reload

# === Tailscale 网段访问 LuCI: 允许 100.64.0.0/10 (CGNAT) ===
if grep -q 'deny all;' /etc/nginx/restrict_locally 2>/dev/null && ! grep -q '100.64.0.0/10' /etc/nginx/restrict_locally 2>/dev/null; then
	T="$(printf '\t')"
	sed -i "/deny all;/i\\${T}allow 100.64.0.0/10;" /etc/nginx/restrict_locally
	/etc/init.d/nginx restart 2>/dev/null
fi

# === Turbo ACC: 放 rc.local 是因为 turboacc 包的 uci-defaults 会覆盖 uci-defaults 里的设置 ===
#   turboacc 包脚本 (按文件名排在 99-* 之后) 会用 cat > 重写 /etc/config/turboacc
#   必须在它跑完之后 (rc.local, S95done) 再设, 并 restart 让其 sync 到 firewall
uci set turboacc.config.fastpath='disabled'
uci set turboacc.config.fastpath_fo_hw='0'
uci set turboacc.config.fullcone='1'
uci set turboacc.config.tcpcca='bbr'
uci commit turboacc
/etc/init.d/turboacc restart >/dev/null 2>&1

# === 自删: 只跑一次 ===
rm -f "$0"
exit 0