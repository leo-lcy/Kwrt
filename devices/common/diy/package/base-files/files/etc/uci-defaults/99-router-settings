#!/bin/sh
#=================================================
# 首次启动自定义设置脚本 (执行后自动删除)
#=================================================

ROOT_PASSWD=__ROOT_PASSWD_SHELL__
PPPOE_USERNAME=__PPPOE_USERNAME_SHELL__
PPPOE_PASSWD=__PPPOE_PASSWD_SHELL__

# === 后台地址 + 子网掩码 ===
uci set network.lan.ipaddr='192.168.10.1'
uci set network.lan.netmask='255.255.255.0'

# === 主机名 ===
uci set system.@system[0].hostname='Router'

# === 时区 ===
uci set system.@system[0].timezone='CST-8'
uci set system.@system[0].zonename='Asia/Shanghai'

# === 后台快捷访问地址 (http://router) ===
echo "192.168.10.1 router" >> /etc/hosts

# =============================================
# ⚠️ 按需修改以下配置，去掉 # 即可启用
# =============================================

# === 后台密码 ===
printf '%s\n%s\n' "$ROOT_PASSWD" "$ROOT_PASSWD" | passwd root

# === PPPoE 拨号账号/密码 ===
uci set network.wan.proto='pppoe'
uci set "network.wan.username=$PPPOE_USERNAME"
uci set "network.wan.password=$PPPOE_PASSWD"

# === 访问光猫 (ToModem 接口) ===
uci set network.ToModem=interface
uci set network.ToModem.proto='static'
uci set network.ToModem.device='wan'
uci set network.ToModem.ipaddr='192.168.1.2'
uci set network.ToModem.netmask='255.255.255.0'
# Firewall zones may use anonymous sections; locate the WAN zone by its name.
for zone in $(uci -q show firewall | sed -n 's/^firewall\.\([^=]*\)=zone$/\1/p'); do
	[ "$(uci -q get "firewall.$zone.name")" = 'wan' ] || continue
	case " $(uci -q get "firewall.$zone.network") " in
		*' ToModem '*) ;;
		*) uci add_list "firewall.$zone.network=ToModem" ;;
	esac
	break
done

# === WiFi 配置见 /etc/rc.local (开机末尾执行, 此时 wireless 配置已生成) ===

# === 旁路由模式 (替换 主路由IP) ===
# uci set network.lan.gateway='192.168.10.254'
# uci set network.lan.dns='223.5.5.5'
# uci del network.wan
# uci del network.wan6

# === SSH 端口改为 30001 ===
uci set dropbear.@dropbear[0].Port='30001'

# === HTTPS 访问后台 (需配合 CONFIG_PACKAGE_luci-ssl-nginx=y) ===
uci set nginx.@main[0].ssl_enable='1'

# === Tailscale 打洞辅助: 允许 wan UDP 41641 入站 ===
uci add firewall rule
uci set firewall.@rule[-1].name='Allow_Tailscale_Input'
uci set firewall.@rule[-1].proto='udp'
uci set firewall.@rule[-1].src='wan'
uci set firewall.@rule[-1].dest_port='41641'
uci set firewall.@rule[-1].target='ACCEPT'

# === Tailscale 网段访问 LuCI: 见 /etc/rc.local (开机末尾执行) ===

# === 关闭 dnsmasq rebind 保护 (passwall2 fake-ip 返回私有段会被拦截) ===
uci set dhcp.@dnsmasq[0].rebind_protection='0'

# === 关闭 miniupnpd (CGNAT 环境下 UPnP 无效, 省资源) ===
/etc/init.d/miniupnpd disable

# LAN ports are provided by board.d: lan2 / lan3 / lan4, with wan kept separate.

# === NTP 换国内源 ===
uci -q delete system.ntp.server
uci add_list system.ntp.server='ntp.aliyun.com'
uci add_list system.ntp.server='ntp.tencent.com'
uci add_list system.ntp.server='cn.ntp.org.cn'

# AX6000: disable both enclosure LEDs, including restored activity rules.
for section in $(uci -q show system | sed -n 's/^system\.\([^=]*\)=led$/\1/p'); do
	case "$(uci -q get "system.$section.sysfs")" in
		rgb:network|rgb:status)
			uci set "system.$section.trigger=none"
			uci set "system.$section.default=0"
			;;
	esac
done
uci set system.led_wan=led
uci set system.led_wan.name='NETWORK_OFF'
uci set system.led_wan.sysfs='rgb:network'
uci set system.led_wan.trigger='none'
uci set system.led_wan.default='0'
uci set system.led_status=led
uci set system.led_status.name='POWER_OFF'
uci set system.led_status.sysfs='rgb:status'
uci set system.led_status.trigger='none'
uci set system.led_status.default='0'

uci commit

exit 0
